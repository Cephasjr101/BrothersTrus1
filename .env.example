# Copy to .env and adjust. All values are optional in development.
BROTHERSTRUST_SECRET=change-me-to-a-long-random-string
BROTHERSTRUST_DB=./backend/bt-travel.db
BROTHERSTRUST_FRONTEND=./frontend
ADMIN_EMAIL=admin@brotherstrusttravel.com
ADMIN_PASSWORD=BT#Admin1

# Firebase Authentication (Google sign-in) — from Firebase Console > Project settings
# Leave blank to hide the Google button and keep email/password only.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_APP_ID=

# World airline data (Amadeus for Developers — https://developers.amadeus.com)
# Leave blank to use the built-in offline demo schedules.
AMADEUS_API_KEY=
AMADEUS_SECRET=
# AMADEUS_PRODUCTION=1   # uncomment after Amadeus moves your app to production
DUFFEL_API_TOKEN=        # duffel_test_... from dashboard.duffel.com (enables LIVE fares + ticketing)
# Duffel settlement: "defer" (default) = Duffel bills you weekly after your
# customer pays via Paystack. "balance" = charge your topped-up Duffel balance.
DUFFEL_PAYMENT_TYPE=defer
